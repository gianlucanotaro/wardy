# Copy to .env and adjust. Never commit .env.

# Server
ADDR=:8080
SECURE=false          # set true in production (enables Secure cookies)
DATA_DIR=./data

# AI — use "mock" in development to avoid burning credits
AI_PROVIDER=mock      # mock | anthropic | ollama
AI_ENABLED=true
ANTHROPIC_API_KEY=    # required only when AI_PROVIDER=anthropic
AI_MONTHLY_BUDGET_USD=5.00

# Weather
# Users set their lat/lon in the app; no key needed for Open-Meteo

# Single sign-on (#51) — "Sign in with Authelia". Leave empty to turn it off.
OIDC_ISSUER=          # e.g. https://auth.gianlucanotaro.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=    # this instance's https://…/api/auth/oidc/callback
OIDC_PROVIDER_NAME=Authelia
